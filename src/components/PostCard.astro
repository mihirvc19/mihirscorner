---
interface Props {
  title:       string;
  date:        Date;
  description: string;
  slug:        string;
}

const { title, date, description, slug } = Astro.props;

const formatted = date.toLocaleDateString('en-US', {
  year:  'numeric',
  month: 'short',
  day:   'numeric',
});
---

<article class="post-card">
  <time class="date" datetime={date.toISOString()}>{formatted}</time>
  <h3><a href={`/blog/${slug}`}>{title}</a></h3>
  <p class="desc">{description}</p>
</article>

<style>
  .post-card {
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--border);
  }

  .post-card:last-child {
    border-bottom: none;
  }

  .date {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.775rem;
    color: var(--muted);
    margin-bottom: 0.3rem;
    letter-spacing: 0.03em;
  }

  .post-card h3 {
    font-size: 1.05rem;
    margin-bottom: 0.4rem;
  }

  .post-card h3 a {
    color: var(--text);
    transition: color 0.15s;
  }

  .post-card h3 a:hover {
    color: var(--accent);
    opacity: 1;
  }

  .desc {
    font-size: 0.9rem;
    color: var(--muted);
    margin: 0;
    line-height: 1.5;
  }
</style>
